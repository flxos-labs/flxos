#include <flx/flxapp/FlxAppYamlBridge.hpp>

#include <cJSON.h>
#include <rapidyaml.hpp>
#include <flx/core/Logger.hpp>

namespace flx::flxapp {

namespace {

constexpr const char* TAG = "FlxAppYamlBridge";

// Forward declaration for recursive conversion.
cJSON* convertNode(const c4::yml::ConstNodeRef& node);

cJSON* convertNode(const c4::yml::ConstNodeRef& node) {
    if (!node.valid()) {
        return nullptr;
    }

    if (node.is_map()) {
        cJSON* object = cJSON_CreateObject();
        for (auto const& child : node.children()) {
            if (child.has_key()) {
                // csubstr is not null-terminated; create a string for cJSON.
                const std::string key(child.key().str, child.key().len);
                cJSON* value = convertNode(child);
                if (value != nullptr) {
                    cJSON_AddItemToObject(object, key.c_str(), value);
                }
            }
        }
        return object;
    }

    if (node.is_seq()) {
        cJSON* array = cJSON_CreateArray();
        for (auto const& child : node.children()) {
            cJSON* converted = convertNode(child);
            if (converted != nullptr) {
                cJSON_AddItemToArray(array, converted);
            }
        }
        return array;
    }

    if (node.is_doc() || node.is_stream()) {
        return node.has_children() ? convertNode(node.first_child()) : cJSON_CreateNull();
    }

    if (node.has_val()) {
        if (node.val_is_null()) {
            return cJSON_CreateNull();
        }

        const c4::csubstr val = node.val();

        // Implicit typing logic for scalars (RapidYAML leaves them as strings by default)
        if (val == "true" || val == "True" || val == "TRUE") return cJSON_CreateTrue();
        if (val == "false" || val == "False" || val == "FALSE") return cJSON_CreateFalse();

        // Try number parsing
        if (!val.empty()) {
            double dval = 0.0;
            if (c4::from_chars(val, &dval)) {
                return cJSON_CreateNumber(dval);
            }
        }

        // Default to string
        const std::string sval(val.str, val.len);
        return cJSON_CreateString(sval.c_str());
    }

    return cJSON_CreateNull();
}

} // namespace

cJSON* FlxAppYamlBridge::yamlStringToCJson(const std::string& yamlText) {
    if (yamlText.empty()) {
        return nullptr;
    }

    // Capture ryml errors via callbacks instead of exceptions (which are disabled).
    static bool callbacksSet = false;
    if (!callbacksSet) {
        c4::yml::Callbacks callbacks;
        callbacks.m_error_parse = [](c4::csubstr msg, c4::yml::ErrorDataParse const& errdata, void*) {
            Log::error("RapidYAML", "Parse error at %lu:%lu: %.*s", 
                       (unsigned long)errdata.ymlloc.line, (unsigned long)errdata.ymlloc.col, (int)msg.len, msg.str);
        };
        callbacks.m_error_basic = [](c4::csubstr msg, c4::yml::ErrorDataBasic const&, void*) {
            Log::error("RapidYAML", "Basic error: %.*s", (int)msg.len, msg.str);
        };
        c4::yml::set_callbacks(callbacks);
        callbacksSet = true;
    }

    // parse_in_arena builds the tree in a temporary buffer.
    c4::yml::Tree tree = c4::yml::parse_in_arena(c4::to_csubstr(yamlText));
    return convertNode(tree.crootref());
}

} // namespace flx::flxapp
