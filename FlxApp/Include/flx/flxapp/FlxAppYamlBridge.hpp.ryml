#pragma once

#include <string>

struct cJSON;

namespace c4 {
namespace yml {
class Tree;
class ConstNodeRef;
}
}

namespace flx::flxapp {

/**
 * @brief Converts a RapidYAML (ryml) tree into an equivalent cJSON tree.
 *
 * This allows YAML-sourced .flxapp files to be processed by the existing
 * cJSON-based FlxAppState, FlxAppRenderer, and FlxAppActionRunner without
 * any changes to those subsystems.
 *
 * The caller owns the returned cJSON* and must call cJSON_Delete() on it.
 */
class FlxAppYamlBridge {
public:

    /**
     * @brief Parse a YAML string and convert it to a cJSON tree.
     * @param yamlText  Raw YAML document string
     * @return Heap-allocated cJSON* on success, nullptr on failure.
     */
    static cJSON* yamlStringToCJson(const std::string& yamlText);
};

} // namespace flx::flxapp
