{
  "app": {
    "id": "com.flxos.flxapp.sysmon",
    "name": "System Monitor",
    "version": "0.1.0",
    "description": "Declarative system monitor sample with reactive bindings",
    "icon": "wifi",
    "sort_priority": 179,
    "capabilities": ["storage", "wifi"]
  },
  "variables": {
    "uptimeSeconds": 0,
    "heapFreeKb": 512,
    "wifiConnected": false,
    "wifiStatus": "Disconnected",
    "wifiSsid": "--",
    "lastUpdate": "Never"
  },
  "ui": {
    "type": "column",
    "children": [
      {
        "type": "label",
        "text": "System Monitor"
      },
      {
        "type": "label",
        "text": "Uptime: {{uptimeSeconds}} s"
      },
      {
        "type": "label",
        "text": "Heap Free: {{heapFreeKb}} KB"
      },
      {
        "type": "bar",
        "key": "heapFreeKb",
        "min": 0,
        "max": 512
      },
      {
        "type": "label",
        "text": "WiFi: {{wifiStatus}}"
      },
      {
        "type": "label",
        "text": "SSID: {{wifiSsid}}"
      },
      {
        "type": "label",
        "text": "Last Update: {{lastUpdate}}"
      },
      {
        "type": "button",
        "text": "Simulate Tick",
        "on_click": [
          {
            "type": "increment",
            "key": "uptimeSeconds",
            "amount": 5
          },
          {
            "type": "decrement",
            "key": "heapFreeKb",
            "amount": 2
          },
          {
            "type": "set",
            "key": "lastUpdate",
            "value": "Now"
          }
        ]
      },
      {
        "type": "row",
        "children": [
          {
            "type": "button",
            "text": "Connect",
            "on_click": [
              {
                "type": "set",
                "key": "wifiConnected",
                "value": true
              },
              {
                "type": "set",
                "key": "wifiStatus",
                "value": "Connected"
              },
              {
                "type": "set",
                "key": "wifiSsid",
                "value": "FLX-Lab"
              }
            ]
          },
          {
            "type": "button",
            "text": "Disconnect",
            "on_click": [
              {
                "type": "set",
                "key": "wifiConnected",
                "value": false
              },
              {
                "type": "set",
                "key": "wifiStatus",
                "value": "Disconnected"
              },
              {
                "type": "set",
                "key": "wifiSsid",
                "value": "--"
              }
            ]
          }
        ]
      }
    ]
  }
}
