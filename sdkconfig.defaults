# FlxOS — Global IDF defaults (profile-agnostic)
# Profile-specific settings are auto-generated into sdkconfig.profile by profile.cmake

CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FATFS_VOLUME_COUNT=3
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_SECTOR_512=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_APPLICATION_TASK_TAG=y
CONFIG_LOG_COLORS=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL=3
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=3584
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LV_DRAW_THREAD_STACK_SIZE=4096
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=4096
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_ARCLABEL=n
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_SPI_FLASH_SIZE_OVERRIDE=y
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_PERF=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_FLXOS_PROFILE="generic-esp32p4"

# === Memory Optimizations ===
# WiFi: reduce static RX buffers from 10 → 6 (ESP-IDF default), saves ~6.5 KB
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# WiFi: reduce Block Ack Window size to match reduced static RX buffers (constraint: WIFI_RX_BA_WIN <= 2 * WIFI_STATIC_RX_BUFFER_NUM)
CONFIG_ESP_WIFI_RX_BA_WIN=6
# WiFi: reduce mgmt sbuf from 16 → 8, saves ~1-2 KB
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# WiFi: disable IRAM placement for WiFi hot-path code, saves ~10-15 KB IRAM
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# WiFi: switch to dynamic TX buffers (saves ~10 KB heap vs static)
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=n
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
# WiFi: reduce cache TX buffers from 32 → 16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
# TLS: use common CA bundle instead of full (~50 CAs vs ~200), saves ~30 KB Flash
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# LVGL: disable unused color-format blend functions (display is 16-bit RGB565)
# Saves ~70-90 KB Flash by removing blend code for formats we never use
CONFIG_LV_DRAW_SW_SUPPORT_RGB565=y
CONFIG_LV_DRAW_SW_SUPPORT_RGB565_SWAPPED=y
CONFIG_LV_DRAW_SW_SUPPORT_A8=y
CONFIG_LV_DRAW_SW_SUPPORT_RGB565A8=n
CONFIG_LV_DRAW_SW_SUPPORT_RGB888=n
CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888=n
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888=y
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED=n
CONFIG_LV_DRAW_SW_SUPPORT_L8=y
CONFIG_LV_DRAW_SW_SUPPORT_AL88=y
CONFIG_LV_DRAW_SW_SUPPORT_I1=n

# --- Dynamic & Buffer Memory Reduction ---
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_LWIP_TCP_WND_DEFAULT=4320
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=16
CONFIG_ESP_IPC_TASK_STACK_SIZE=1024
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=4
CONFIG_LWIP_IPV6_DUP_DETECT_ATTEMPTS=0

# --- IRAM Reduction: SPIRAM XIP ---
# Execute flash code and read rodata from PSRAM when flash cache is disabled
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# --- Stack & BSS Reduction ---
CONFIG_FREERTOS_ISR_STACKSIZE=1024
CONFIG_COMPILER_CXX_EXCEPTIONS=n

# Disable LVGL Trace Modules
CONFIG_LV_LOG_TRACE_MEM=n
CONFIG_LV_LOG_TRACE_TIMER=n
CONFIG_LV_LOG_TRACE_INDEV=n
CONFIG_LV_LOG_TRACE_DISP_REFR=n
CONFIG_LV_LOG_TRACE_EVENT=n
CONFIG_LV_LOG_TRACE_OBJ_CREATE=n
CONFIG_LV_LOG_TRACE_LAYOUT=n
CONFIG_LV_LOG_TRACE_ANIM=n
CONFIG_LV_LOG_TRACE_CACHE=n

# Shrink bootloader to fit partition table offset of 0x8000
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2

# Suppress High Performance Mode QSPI Flash warnings treated as errors
CONFIG_SPI_FLASH_HPM_DC_DISABLE=y


